# Example configuration without real secrets.
# Copy to .env for local usage (never commit .env to version control).

# Environment mode.
# Fallback dev secrets are permitted ONLY when at least one of ENV/APP_ENV
# is explicitly set AND all specified values are in:
# {test, testing, dev, development}.
# Production, staging, conflicting, or unset values forbid fallback keys.
ENV=development
APP_ENV=development

# Mandatory in production/staging: valid 32 url-safe base64 Fernet key.
# Generate locally with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INVENTORY_ENCRYPTION_KEY=replace_with_generated_fernet_key

# Mandatory in production/staging: secret HMAC-SHA256 pepper for inventory fingerprints.
# src/db/crypto.py checks FINGERPRINT_PEPPER first, then INVENTORY_FINGERPRINT_PEPPER.
FINGERPRINT_PEPPER=replace_with_random_secret_pepper

# Note: ALLOW_DEV_FALLBACK_KEY=1 (checked in remediation tests) NEVER bypasses
# production, staging, conflicting, or unset environment checks.
ALLOW_DEV_FALLBACK_KEY=0
